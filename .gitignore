# Python
__pycache__/
*.pyc
*.pyo
.coverage
.testmondata

# Tests
.pytest_cache/
tests/__pycache__/

# Build / Distribution
build/
dist/
.build_venv/
*.exe
Installer_*/

# Scratch / temp (project-bound; disposable — workspace convention)
.tmp/

# Delivery inbox — may hold sensitive data. Empty after processing; processed files move to
# import-archiv/<timestamp>/ (workspace convention). Never commit either to this PUBLIC repo.
import/
import-archiv/

# Vendor reference material kept locally (DATEVconnect OpenAPI specs = vendor IP). Never commit.
/vendor/

# Generated by scripts/build_datev_probe.ps1 (CLI flags are authoritative; regenerated each build)
/DATEV-Probe.spec

# Playwright artifacts if it is ever run from the repo root (normally lives in webui/)
test-results/

# Hand-rolled zip of the tester kit (the kit itself is tracked under manual_tests/testpakete/)
manual_tests/testpakete.zip

# Audit reports (local artifacts; keep them off the public repo)
reports/

# VS Code
.vscode/

# Claude Code
.claude/

# Logs
*.log

# Debug- und Test-Artefakte
debug_*.pdf
build_log.txt
tests/data/output/
merge_dpi_conflict*.pdf

# Beta-tester feedback drop (tester screenshots / personal data — keep out of the repo)
Beta-Feedback/

# Windows Sandbox configs (machine-specific host paths; local dev helper)
*.wsb

# MSIX packaging build artifacts (generated; manifest + scripts ARE tracked)
packaging/Assets/
packaging/msix_layout/
packaging/out/
*.msix
*.msixupload
*.pfx
*.cer

# User documents — never commit real .belegtool files (may contain personal data)
*.belegtool
# …except the synthetic samples of the generated tester kit (invented data only,
# built by scripts/build_testkit.py)
!manual_tests/testpakete/**/*.belegtool

# Live DATEV connection config next to the exe (site-specific host/auth). The shipped
# template datev.config.example.json IS tracked; the real datev.config.json is not.
datev.config.json

# Internal DATEV diagnostics / handoff notes — contain real SIDs, Nutzer-GUIDs, hostnames.
# NEVER commit to this PUBLIC repo; kept locally as reference only.
docs/datev-ticket-deleted-nutzer.md
docs/SESSION_HANDOFF.md

# Python build artifacts (pip install ./packages/...)
*.egg-info/
build/
